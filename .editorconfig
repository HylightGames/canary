# EditorConfig helps keep formatting consistent across the languages and tooling used by Canary.

# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing spaces can have semantic meaning in Markdown (for example, explicit line breaks), so preserve them.
trim_trailing_whitespace = false
indent_size = 2

[*.{js,jsx,ts,tsx}]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 2

[Makefile]
indent_style = tab
