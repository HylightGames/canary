# EditorConfig helps keep formatting consistent across the many languages a
# language-agnostic engine attracts (see docs/development/coding-standards.md).
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{c,h,cpp,hpp,cc,cxx}]
indent_size = 4

[*.py]
indent_size = 4

[*.{js,ts,jsx,tsx}]
indent_size = 2

[Makefile]
indent_style = tab
