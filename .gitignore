# ==============================================================================

# Canary Engine — .gitignore

# ==============================================================================

# --- Rust / Cargo -------------------------------------------------------------

/target/
Cargo.lock.bak
*.pdb

# --- Generated build / packaging output ---------------------------------------

/build/
/dist/
/out/
/.cache/
/.canary-cache/
*.cooked
*.cwasm

# --- WebAssembly build artifacts ----------------------------------------------

*.wasm

# --- Native build artifacts ---------------------------------------------------

*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exp

CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json

# --- Vendored dependency build output ----------------------------------------

/vendor/**/build/

# --- JavaScript / Node.js tooling ---------------------------------------------

node_modules/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Python tooling -----------------------------------------------------------

__pycache__/
*.py[cod]
*.pyd
.venv/
.venv*/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Editors / IDEs -----------------------------------------------------------

.idea/
*.iml

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

*.swp
*.swo
*~

# --- Operating system files ---------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
Icon

._*

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db

Desktop.ini

# --- Logs / local configuration -----------------------------------------------

*.log
.env
.env.local
.env.*.local

# --- Temporary files ----------------------------------------------------------

*.tmp
*.temp
*.bak
*.orig
*.rej

# Cargo.lock is intentionally tracked.

# Canary ships binaries and executable tooling, so dependency resolution is part of the repository and must remain under version control.
